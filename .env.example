# === Required ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_AUTHORIZED_USER_ID=your-telegram-numeric-user-id

# === LLM API Key ===
OPENAI_API_KEY=your-openai-api-key

# === LLM Model & Behavior (optional) ===
# OPENAI_MODEL=gpt-5.1
# LLM_MAX_TOKENS=8192
# HISTORY_TOKEN_BUDGET=30000
# SESSION_IDLE_RESET_MINUTES=120
# USER_NAME=Josh
# VOICE_MODEL=gpt-4o-mini-transcribe

# === Search & Indexing (optional) ===
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=512
# BACKFILL_MAX_EMAILS=2000
# INDEX_POLL_INTERVAL_MINUTES=10

# === Morning Digest ===
# DIGEST_ENABLED=1
# DIGEST_HOUR=8

# === Optional Security ===
# Set a PIN that must be entered after bot restart before it accepts commands
# Leave blank to disable
SESSION_PIN=

# Max outbound actions (emails, messages) per hour
RATE_LIMIT_PER_HOUR=20

# === Gmail ===
# Gmail uses credentials.json in the project root (see README) and per-account
# token files created by /addaccount. This sets which account starts active:
# DEFAULT_GMAIL_ACCOUNT=personal

# === OneDrive (personal Microsoft account) ===
# ONEDRIVE_CLIENT_ID=your-azure-app-client-id

# === Google Places API (for review monitoring) ===
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# REVIEW_POLL_INTERVAL_MINUTES=15
