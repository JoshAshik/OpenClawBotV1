# === Required ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_AUTHORIZED_USER_ID=your-telegram-numeric-user-id   # comma-separate to allow more people; the first id is the owner who gets digests/alerts

# === LLM API Key ===
OPENAI_API_KEY=your-openai-api-key

# === LLM Model & Behavior (optional) ===
# OPENAI_MODEL=gpt-5.1
# OPENAI_FAST_MODEL=gpt-5-mini
# MAX_PARALLEL_TOOLS=4
# OPENAI_TIMEOUT_SECONDS=60
# TURN_TIMEOUT_SECONDS=180
# LLM_MAX_TOKENS=8192
# HISTORY_TOKEN_BUDGET=30000
# SESSION_IDLE_RESET_MINUTES=120
# USER_NAME=Josh
# VOICE_MODEL=gpt-4o-mini-transcribe

# === Search & Indexing (optional) ===
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=512
# BACKFILL_MAX_EMAILS=2000
# INDEX_POLL_INTERVAL_MINUTES=10
# IMESSAGE_DB_PATH=            # override ~/Library/Messages/chat.db (fixture on Windows)
# IMESSAGE_BATCH_SIZE=2000
# IMESSAGE_WATCH_SECONDS=30      # chat.db change check cadence; 0 disables
# CONTACTS_DB_PATH=            # override the Apple Contacts store (fixture on Windows)
# CONTACTS_DEFAULT_COUNTRY=1   # country code assumed for numbers stored without one

# === Morning Digest ===
# DIGEST_ENABLED=1
# DIGEST_HOUR=8
# EVENING_DIGEST_HOUR=0          # e.g. 18 for a 6pm wrap-up; 0 disables

# === Reminders ===
# REMINDER_HOUR=9

# === Waiting-on tracker ===
# WAITING_ON_DAYS=3

# === Urgent alerts ===
# ALERTS_ENABLED=1
# ALERT_POLL_MINUTES=3
# ALERT_QUIET_HOURS=23-7
# ALERT_MAX_AGE_HOURS=24

# === Optional Security ===
# Set a PIN that must be entered after bot restart before it accepts commands
# Leave blank to disable
SESSION_PIN=

# Max outbound actions (emails, messages) per hour
RATE_LIMIT_PER_HOUR=20

# === Gmail ===
# Gmail uses credentials.json in the project root (see README) and per-account
# token files created by /addaccount. This sets which account starts active:
# DEFAULT_GMAIL_ACCOUNT=personal

# === OneDrive (personal Microsoft account) ===
# ONEDRIVE_CLIENT_ID=your-azure-app-client-id

# === Google Places API (for review monitoring) ===
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# REVIEW_POLL_INTERVAL_MINUTES=15

# === Nightly database backup ===
# BACKUP_ENABLED=1
# BACKUP_HOUR=3
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
